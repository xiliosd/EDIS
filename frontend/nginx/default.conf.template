server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    # Un add_header dentro de una location anula los del server: por eso el include se repite.
    include /etc/nginx/snippets/security-headers.conf;

    location /api/ {
        proxy_pass ${BACKEND_URL};
        # Host original (con puerto) para que el backend reconozca las peticiones del mismo origen.
        # nosemgrep: generic.nginx.security.request-host-used.request-host-used
        proxy_set_header Host $http_host;
        # Se sobrescribe (no se anexa) para que el cliente no pueda falsificar su IP.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Correlation-Id $request_id;
    }

    # Importación del paquete de promoción: el backend admite 5 MB de ZIP (6 MB de petición) y
    # responde 413 en español; el resto de /api/ sigue con el tope de 1 MB de nginx. La regex
    # gana sobre el prefijo /api/. BACKEND_URL no lleva ruta: proxy_pass sin URI es válido aquí.
    location ~ ^/api/v1/admin/questionnaire/[^/]+/[0-9]+/package/import$ {
        client_max_body_size 6m;
        client_body_buffer_size 6m;
        proxy_pass ${BACKEND_URL};
        # nosemgrep: generic.nginx.security.request-host-used.request-host-used
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Correlation-Id $request_id;
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        include /etc/nginx/snippets/security-headers.conf;
    }

    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/snippets/security-headers.conf;
    }
}
